# Copy this file to .env.local and fill in the values. .env.local is not committed.

# Public address of the site, used for canonical links, hreflang and the sitemap.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Delivery of the "Presenta un prodotto" form, via Resend (https://resend.com).
# 1. Create a Resend account and an API key.
# 2. Verify your domain in Resend to send from your own address.
#    Until then, the "onboarding@resend.dev" sender only delivers to your Resend account's email.
RESEND_API_KEY=
# Where enquiries are sent (comma-separated for more than one address).
ENQUIRY_TO_EMAIL=
# Sender shown on the email, on a domain verified in Resend.
ENQUIRY_FROM_EMAIL="Sito web <richieste@tuodominio.it>"
